#!/bin/bash
# SSH_ASKPASS handler that gates every use of an ssh-agent key behind the
# fingerprint reader. Deployed to /usr/local/bin by bootstrap-linux laptop().
#
# ssh-agent runs this for any key held with the confirm flag, which we get from
# `AddKeysToAgent confirm` in ~/.ssh/config. Per ssh-add(1), confirmation is
# signalled by the *exit status* of this program, not by anything it prints:
# 0 allows the signature, non-zero denies it. ssh-agent passes the prompt it
# wanted to display (which key, and its fingerprint) as $1.
#
# This file MUST be root-owned and not writable by the login user. Anything
# running as elmeri that can rewrite it just replaces the body with `exit 0`
# and the whole gate disappears.
#
# -f any identifies against every enrolled print. Without it fprintd-verify
# checks only the first enrolled finger, so a second enrolled finger could
# never match.
#
# Each verification gets 10 seconds. A failed touch starts another verification;
# three failures or 30 seconds without a match denies the signature.

# >&2 is load-bearing, not tidiness. ssh-agent runs this with a pipe on our
# stdout and READS it: per ask_permission() in OpenSSH readpass.c only an empty
# line or the word "yes" counts as affirmative, and a non-zero exit is a refusal
# regardless. fprintd-verify prints "Using device /net/reactivated/..." on
# stdout, which reads as a refusal even when the scan matched. Sending its
# output to stderr leaves the pipe empty (affirmative) and puts the chatter in
# the journal instead, where it is useful.

set -u

for _ in 1 2 3; do
    timeout 10 fprintd-verify -f any >&2 && exit 0
done

exit 1

#!/bin/bash
# SSH_ASKPASS handler that gates every use of an ssh-agent key behind the
# fingerprint reader. Deployed to /usr/local/bin by bootstrap-linux laptop().
#
# ssh-agent runs this for any key held with the confirm flag, which we get from
# `AddKeysToAgent confirm` in ~/.ssh/config. Per ssh-add(1), confirmation is
# signalled by the *exit status* of this program, not by anything it prints:
# 0 allows the signature, non-zero denies it. ssh-agent passes the prompt it
# wanted to display (which key, and its fingerprint) as $1.
#
# This file MUST be root-owned and not writable by the login user. Anything
# running as elmeri that can rewrite it just replaces the body with `exit 0`
# and the whole gate disappears.

set -u
# Fail closed. fprintd-verify's exit status is not dependable across fprintd
# versions and drivers, so require the explicit success string in its output
# and treat literally everything else -- no match, reader busy, timeout,
# fprintd not running -- as a denial.
out="$(timeout 600 fprintd-verify 2>&1)"
case "$out" in
    *verify-match*) exit 0 ;;
esac
exit 1

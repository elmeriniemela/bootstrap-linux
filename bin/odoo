#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<EOF
Usage:
  $ odoo [function] [args...]
  $ odoo [odoo-bin args...]
  $ odoo --help

Description:
  **Odoo version ${ODOO_VERSION}**. Odoo core code can be found from ~/Odoo/src/${ODOO_VERSION}/odoo/ and ~/Odoo/src/${ODOO_VERSION}/enterprise/.
  The script is for running Odoo locally via AI agents. It assumes the current working directory is an Odoo module.
  - function: optional, chooses a non-server branch.

Supported functions:
  upgrade
  install
  dropdb
  tests [optional --no-coverage]
  translate <lang>

Default behavior:
  Runs the Odoo server (run_server) when no function is selected.

Optional args are passed into odoo-bin, unless the function specifies a separate meaning for them.
EOF
}

ensure_odoo_env() {
    local dir="$PWD"

    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/odoorc.env" ]]; then
            source $dir/odoorc.env
            export ODOO_VENV="$HOME/.venv/odoo$ODOO_VERSION/bin"
            export ODOO_VERSION_DIR=$HOME"/Odoo/src/${ODOO_VERSION}"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    echo "Error: odoorc.env does not exist in any parent dir." >&2
    exit 1
}

ensure_odoo_config() {
    if [ -z "${ODOO_CONFIG_FILE:-}" ] || [ ! -f "$ODOO_CONFIG_FILE" ]; then
        local dir="$PWD"
        while [[ "$dir" != "/" ]]; do
            if [[ -f "$dir/odoorc.conf" ]]; then
                export ODOO_CONFIG_FILE="$dir/odoorc.conf"
                export ODOO_MODULE="$(basename "$PWD")"
                export ODOO_DATABASE="$ODOO_VERSION-$ODOO_MODULE"
                if [[ ! -f "__manifest__.py" ]]; then
                    echo "Error: __manifest__.py does not exist. $ODOO_MODULE is not an odoo module." >&2
                    exit 1
                fi
                return 0
            fi
            dir="$(dirname "$dir")"
        done
        echo "Error: odoorc.conf does not exist in any parent dir." >&2
        exit 1
    else
        echo "Using custom ODOO_CONFIG_FILE=$ODOO_CONFIG_FILE..."
    fi
}

run_server() {
    if [[ -z "${1:-}" || "$1" == @(server|shell|neutralize|obfuscate|populate) ]]; then
        if [ -n "${ODOO_DATABASE:-}" ]; then
            $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin $* --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --db-filter "^$ODOO_DATABASE$"
        else
            $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin $* --conf $ODOO_CONFIG_FILE
        fi
    else
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin $*
    fi
}
run_upgrade() {
    $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --db-filter "^$ODOO_DATABASE$" -u $ODOO_MODULE --stop-after-init --no-http
}
run_dropdb() {
    dropdb $ODOO_DATABASE 2>/dev/null || :
}
run_install() {
    echo "Install $ODOO_MODULE"
    $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --db-filter "^$ODOO_DATABASE$" --load-language=en_US -i $ODOO_MODULE --stop-after-init --no-http
}
run_tests() {
    if [[ " $* " == *" --no-coverage "* ]]; then
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --db-filter "^$ODOO_DATABASE$" -u $ODOO_MODULE --stop-after-init --no-http --test-enable --test-tags=$ODOO_MODULE
    else
        $ODOO_VENV/python -m coverage run --omit=__manifest__.py --source="$PWD" "$ODOO_VERSION_DIR/odoo/odoo-bin" --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --db-filter "^$ODOO_DATABASE$" -u $ODOO_MODULE --stop-after-init --no-http --test-enable --test-tags=$ODOO_MODULE
        $ODOO_VENV/python -m coverage report -m
    fi
}
run_translate() {
    run_upgrade
    mkdir -p i18n
    touch i18n/$1.po
    SAVED_TSV="i18n/saved.tsv"
    trap 'rm -rf "i18n/saved.tsv"' EXIT


    extract_i18n.awk "i18n/$1.po" "$SAVED_TSV"
    if (( ODOO_VERSION <= 18 )); then
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE -u $ODOO_MODULE --load-language=fi_FI --stop-after-init
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin --i18n-export=i18n/$1.po --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --modules=$ODOO_MODULE --language=fi_FI
    else
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin i18n loadlang --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE --languages=$1
        $ODOO_VENV/python $ODOO_VERSION_DIR/odoo/odoo-bin i18n export --conf $ODOO_CONFIG_FILE -d $ODOO_DATABASE $ODOO_MODULE --languages=$1
    fi
    restore_i18n.awk "i18n/$1.po" "$SAVED_TSV" > "i18n/$1.po.tmp"
    mv "i18n/$1.po.tmp" "i18n/$1.po"
}

ensure_odoo_env
ensure_odoo_config

case "${1-}" in
  upgrade)
    shift
    run_upgrade "$@"
    ;;
  install)
    shift
    run_install "$@"
    ;;
  dropdb)
    shift
    run_dropdb "$@"
    ;;
  tests)
    shift
    run_tests "$@"
    ;;
  translate)
    shift
    run_translate "$@"
    ;;
  --help)
    show_help
    ;;
  *)
    run_server "$@"
    ;;
esac
